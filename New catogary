    st.sidebar.text(f"• {kw.title()}")

# Logic to filter job listings dataframe based on the active keywords list
def filter_jobs_by_department(df, keywords):
    pattern = '|'.join([f"\\b{kw}\\b" for kw in keywords])
    filtered_df = df[df['Job Title'].str.contains(pattern, case=False, na=False)]
    return filtered_df
